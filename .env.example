# LLM API configuration (choose one, or leave blank to use the offline Mock client)
# Optional explicit provider override: openrouter | xai | gemini | mock
# LLM_PROVIDER=openrouter

# 1. OpenRouter (Recommended for Grok via OpenRouter API key):
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_MODEL=x-ai/grok-3-beta

# 2. xAI Grok (Direct API):
# XAI_API_KEY=xai-your-api-key-here
# GROK_MODEL=grok-2-latest

# 3. Google Gemini via OpenAI-compatible endpoint:
# GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# 4. OpenAI:
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Agent configuration
MAX_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=15
APPROVAL_TIMEOUT_SECONDS=120

# Optional Server paths
OPS_DATA_DIR=../mock_data
